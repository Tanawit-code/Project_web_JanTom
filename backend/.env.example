# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
# (.env ถูก ignore ไว้แล้ว ห้าม commit และห้ามส่งในแชท/รูปภาพ)

PORT=4100

# --- ฐานข้อมูล MySQL / MariaDB ---
DB_HOST=localhost
DB_USER=root
# XAMPP ส่วนใหญ่ root ไม่มีรหัสผ่าน ให้ปล่อยว่างไว้ (DB_PASSWORD=)
DB_PASSWORD=
DB_NAME=assetdb

# --- JWT ---
# ต้องเปลี่ยนเป็นข้อความสุ่มยาวๆ ของตัวเอง สร้างได้ด้วยคำสั่ง:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# --- ระบบสมัครสมาชิก / ลืมรหัสผ่าน / แจ้งเตือนทางอีเมล ---
# อีเมลของ admin ที่จะรับคำขอสมัครสมาชิกและแจ้งสลิปค่าปรับ
ADMIN_EMAIL=admin@yourcompany.com
# URL ของหน้าเว็บ frontend (ใช้สร้างลิงก์ในอีเมล)
FRONTEND_URL=http://localhost:5180

# SMTP: ถ้าเว้น SMTP_USER/SMTP_PASS ไว้ ระบบจะไม่ส่งเมลจริง แต่พิมพ์ลิงก์ลงใน console ของ backend แทน (สะดวกตอนพัฒนา)
# ใช้ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 และใช้ "App Password" 16 ตัว (ไม่ใช่รหัสผ่าน Gmail ปกติ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- ระบบค่าปรับ ---
# บัญชี PromptPay ที่รับเงินค่าปรับ: เบอร์โทร 10 หลัก (0812345678) หรือเลข 13 หลัก
# ถ้าเว้นว่าง จะสร้าง QR ชำระเงินไม่ได้
PROMPTPAY_ID=
# ชื่อบัญชีที่แสดงให้พนักงานเห็นตอนสแกนจ่าย
PROMPTPAY_NAME=
# ค่าปรับส่งคืนล่าช้า บาทต่อวัน (ใช้เป็นค่าเริ่มต้นตอนรับคืน แก้ไขได้)
FINE_PER_DAY=100
